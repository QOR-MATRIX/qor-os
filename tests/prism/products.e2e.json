{
  "description": "Prism hosting the products (QOR-0010): it starts ARQADE and QOR Media as Wayland clients of its own, speaking the QOR Launcher's side of the host protocol, and places their windows where it planned; it starts QQ Studio and the QQ Player with no channel, and their windows open at the size they ask for, fitted to the screen. Every window is named from Prism's own records. Run by ctest as prism_products, through tools/dev/prism-products.py, with stand-ins for all four, at 1920 x 1200 (a work area of 1900 x 1052 at 10, 52).",
  "steps": [
    { "log": "ARQADE, asked for as Prism starts (perhaps before the desktop is laid out): started, placed where Prism plans, known by Prism's record" },
    { "call": "launch", "args": ["arqade", {}] },
    { "expect": { "path": "products.arqade.available", "equals": true } },
    { "expect": { "path": "products.qor-media.available", "equals": true } },
    { "expect": { "path": "products.arqade.running", "equals": true } },
    { "expect": { "path": "products.qor-media.running", "equals": false } },
    { "waitFor": { "window": { "title": "Test ARQADE" }, "timeout": 20000 } },
    { "wait": 1200 },
    { "expect": { "path": "products.arqade.running", "equals": true } },
    { "expect": { "window": { "title": "Test ARQADE" }, "path": "appId", "equals": "arqade" } },
    { "expect": { "window": { "appId": "arqade" }, "path": "isClient", "equals": true } },
    { "expect": { "window": { "appId": "arqade" }, "path": "decorated", "equals": true } },
    { "expect": { "window": { "appId": "arqade" }, "path": "focused", "equals": true } },
    { "expect": { "window": { "appId": "arqade" }, "path": "identity.name", "equals": "ARQADE" } },
    { "expect": { "window": { "appId": "arqade" }, "path": "frameRect", "near": [220, 80, 1360, 900], "tolerance": 1 } },
    { "expect": { "window": { "appId": "arqade" }, "path": "configuredSize", "near": [1360, 860], "tolerance": 1 } },
    { "expect": { "window": { "appId": "arqade" }, "path": "clientGeometry", "near": [0, 0, 1360, 860], "tolerance": 1 } },

    { "log": "ARQADE in front plays with the controller: its games and its home answer it themselves" },
    { "expect": { "path": "controller.game", "equals": true } },

    { "log": "The person's Motion setting reaches it while it runs" },
    { "call": "runAction", "args": ["motion.toggle", {}] },
    { "wait": 1000 },
    { "expect": { "window": { "appId": "arqade" }, "path": "title", "equals": "Test ARQADE · less motion" } },
    { "call": "runAction", "args": ["motion.toggle", {}] },
    { "wait": 1000 },
    { "expect": { "window": { "appId": "arqade" }, "path": "title", "equals": "Test ARQADE" } },

    { "log": "Opening it again brings its window back, not a second ARQADE" },
    { "call": "launch", "args": ["arqade", {}] },
    { "wait": 800 },
    { "waitFor": { "windows": 1, "timeout": 2000 } },

    { "log": "Closing its window ends it" },
    { "close": { "appId": "arqade" } },
    { "waitFor": { "gone": { "appId": "arqade" }, "timeout": 10000 } },
    { "wait": 1500 },
    { "expect": { "path": "products.arqade.running", "equals": false } },

    { "log": "QOR Media: opens the file Prism asks for, at Prism's layout" },
    { "call": "openInMedia", "args": ["/srv/films/clip.mkv", "video"] },
    { "waitFor": { "window": { "title": "Test QOR Media" }, "timeout": 20000 } },
    { "wait": 1200 },
    { "expect": { "window": { "title": "Test QOR Media" }, "path": "appId", "equals": "qor-media" } },
    { "expect": { "window": { "appId": "qor-media" }, "path": "identity.name", "equals": "QOR Media" } },
    { "expect": { "window": { "appId": "qor-media" }, "path": "title", "equals": "clip.mkv — Test QOR Media" } },
    { "expect": { "window": { "appId": "qor-media" }, "path": "frameRect", "near": [260, 130, 1280, 800], "tolerance": 1 } },
    { "expect": { "window": { "appId": "qor-media" }, "path": "configuredSize", "near": [1280, 760], "tolerance": 1 } },
    { "log": "QOR Media keeps the shell's controller interface: its d-pad comes as the arrow keys" },
    { "expect": { "path": "controller.game", "equals": false } },
    { "close": { "appId": "qor-media" } },
    { "waitFor": { "gone": { "appId": "qor-media" }, "timeout": 10000 } },
    { "wait": 1500 },
    { "expect": { "path": "products.qor-media.running", "equals": false } },

    { "log": "QQ Studio, opened as from Beam: started with no channel, at the size it asks for (2000 x 1300), fitted to the work area" },
    { "expect": { "path": "products.qq-studio.available", "equals": true } },
    { "expect": { "path": "products.qq-player.available", "equals": true } },
    { "call": "launch", "args": ["qq-studio", {}] },
    { "waitFor": { "window": { "title": "Test QQ Studio" }, "timeout": 20000 } },
    { "wait": 1200 },
    { "expect": { "path": "products.qq-studio.running", "equals": true } },
    { "expect": { "window": { "title": "Test QQ Studio" }, "path": "appId", "equals": "qq-studio" } },
    { "expect": { "window": { "appId": "qq-studio" }, "path": "identity.name", "equals": "QQ Studio" } },
    { "expect": { "window": { "appId": "qq-studio" }, "path": "decorated", "equals": true } },
    { "expect": { "window": { "appId": "qq-studio" }, "path": "frameRect", "near": [10, 52, 1840, 1012], "tolerance": 1 } },
    { "expect": { "window": { "appId": "qq-studio" }, "path": "configuredSize", "near": [1840, 972], "tolerance": 1 } },
    { "expect": { "window": { "appId": "qq-studio" }, "path": "clientGeometry", "near": [0, 0, 1840, 972], "tolerance": 1 } },

    { "log": "A controller connected with QQ Studio in front: asked about, and the controller interface turned on" },
    { "gamepad": { "connect": "playstation", "name": "DualSense" } },
    { "wait": 700 },
    { "expect": { "path": "controller.prompt", "equals": true } },
    { "gamepad": { "tap": "south" } },
    { "wait": 600 },
    { "expect": { "path": "settings.controllerInterface", "equals": true } },
    { "expect": { "path": "controller.acting", "equals": true } },
    { "expect": { "path": "controller.game", "equals": false } },

    { "log": "The QQ Player plays the scene it is given, at its own 1280 x 720, cascaded from the Studio" },
    { "call": "playQQGame", "args": ["/srv/games/orb-run/scenes/orb-run.qml"] },
    { "waitFor": { "window": { "title": "orb-run.qml — Test QQ Player" }, "timeout": 20000 } },
    { "wait": 1200 },
    { "expect": { "path": "products.qq-player.running", "equals": true } },
    { "expect": { "window": { "title": "orb-run.qml — Test QQ Player" }, "path": "appId", "equals": "qq-player" } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "identity.name", "equals": "QQ Player" } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "focused", "equals": true } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "frameRect", "near": [290, 174, 1280, 760], "tolerance": 1 } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "configuredSize", "near": [1280, 720], "tolerance": 1 } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "clientGeometry", "near": [0, 0, 1280, 720], "tolerance": 1 } },

    { "log": "The QQ Player in front plays with the controller: the controller interface steps aside; Guide brings Overview, East the game again" },
    { "expect": { "path": "controller.game", "equals": true } },
    { "expect": { "path": "controller.acting", "equals": false } },
    { "gamepad": { "tap": "guide" } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "overview" } },
    { "expect": { "path": "controller.game", "equals": false } },
    { "expect": { "path": "controller.acting", "equals": true } },
    { "gamepad": { "tap": "east" } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "" } },
    { "expect": { "path": "controller.game", "equals": true } },

    { "log": "One game at a time: asked for another, the one playing stays" },
    { "call": "playQQGame", "args": ["/srv/games/ember-climb/scenes/ember-climb.qml"] },
    { "wait": 1200 },
    { "waitFor": { "windows": 2, "timeout": 2000 } },
    { "expect": { "window": { "appId": "qq-player" }, "path": "title", "equals": "orb-run.qml — Test QQ Player" } },

    { "log": "A controller connected while a game is in front is the game's: nothing is asked" },
    { "gamepad": { "disconnect": true } },
    { "wait": 600 },
    { "expect": { "path": "settings.controllerInterface", "equals": false } },
    { "gamepad": { "connect": "playstation", "name": "DualSense" } },
    { "wait": 700 },
    { "expect": { "path": "controller.game", "equals": true } },
    { "expect": { "path": "controller.prompt", "equals": false } },
    { "gamepad": { "disconnect": true } },
    { "wait": 400 },

    { "log": "Closing their windows ends them; closed while minimised, a window goes at once" },
    { "click": { "window": { "appId": "qq-player" }, "part": "minimize" } },
    { "wait": 1500 },
    { "expect": { "window": { "appId": "qq-player" }, "path": "minimized", "equals": true } },
    { "close": { "appId": "qq-player" } },
    { "waitFor": { "gone": { "appId": "qq-player" }, "timeout": 10000 } },
    { "wait": 500 },
    { "expect": { "path": "windows.length", "equals": 1 } },
    { "close": { "appId": "qq-studio" } },
    { "waitFor": { "gone": { "appId": "qq-studio" }, "timeout": 10000 } },
    { "wait": 1500 },
    { "expect": { "path": "products.qq-player.running", "equals": false } },
    { "expect": { "path": "products.qq-studio.running", "equals": false } }
  ]
}
