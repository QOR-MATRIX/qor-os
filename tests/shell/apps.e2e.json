{
  "description": "First-party apps under real (synthetic) input: item-based controls receive clicks (including the Sound page's equaliser and audio-reactive controls), and window management works. Run by ctest as shell_e2e: qtos-shell --script tests/shell/apps.e2e.json.",
  "steps": [
    { "log": "Settings: an item-based Lumen control receives a click" },
    { "call": "launch", "args": ["settings", { "page": "accessibility" }] },
    { "waitFor": { "windows": 1, "timeout": 10000 } },
    { "wait": 1200 },
    { "expect": { "path": "settings.reduceMotion", "equals": false } },
    { "click": { "item": "reduceMotionSwitch" } },
    { "wait": 500 },
    { "expect": { "path": "settings.reduceMotion", "equals": true } },
    { "click": { "item": "reduceMotionSwitch" } },
    { "wait": 500 },
    { "expect": { "path": "settings.reduceMotion", "equals": false } },

    { "log": "Sound: equaliser presets, the audio-reactive switch and its frequency presets" },
    { "call": "launch", "args": ["settings", { "page": "sound" }] },
    { "wait": 900 },
    { "click": { "window": "Settings", "part": "maximize" } },
    { "wait": 900 },
    { "scroll": { "at": { "window": "Settings", "part": "content", "at": [500, 300] }, "notches": 2 } },
    { "wait": 700 },
    { "click": { "item": "eqPreset1" } },
    { "wait": 500 },
    { "expect": { "path": "audio.equalizerPreset", "equals": "Bass Boost" } },
    { "expect": { "path": "audio.equalizer", "equals": [6, 3.5, 0, 0, 0] } },
    { "click": { "item": "eqPreset0" } },
    { "wait": 500 },
    { "expect": { "path": "audio.equalizerPreset", "equals": "Flat" } },
    { "scroll": { "at": { "window": "Settings", "part": "content", "at": [500, 300] }, "notches": 20 } },
    { "wait": 900 },
    { "click": { "item": "audioReactiveSwitch" } },
    { "wait": 500 },
    { "expect": { "path": "settings.audioReactive", "equals": false } },
    { "click": { "item": "audioReactiveSwitch" } },
    { "wait": 500 },
    { "expect": { "path": "settings.audioReactive", "equals": true } },
    { "click": { "item": "reactivePreset1" } },
    { "wait": 500 },
    { "expect": { "path": "settings.reactiveLowHz", "equals": 300 } },
    { "expect": { "path": "settings.reactiveHighHz", "equals": 3000 } },
    { "click": { "item": "reactivePreset0" } },
    { "wait": 500 },
    { "expect": { "path": "settings.reactiveLowHz", "equals": 40 } },
    { "click": { "window": "Settings", "part": "maximize" } },
    { "wait": 900 },

    { "log": "Maximise and restore" },
    { "click": { "window": "Settings", "part": "maximize" } },
    { "wait": 900 },
    { "expect": { "window": "Settings", "path": "maximized", "equals": true } },
    { "expect": { "window": "Settings", "path": "frameRect", "near": "workArea" } },
    { "click": { "window": "Settings", "part": "maximize" } },
    { "wait": 900 },
    { "expect": { "window": "Settings", "path": "maximized", "equals": false } },

    { "log": "Snap by dragging the title bar to the left edge" },
    { "drag": { "from": { "window": "Settings", "part": "titlebar", "at": [140, 20] }, "to": [3, 400], "steps": 20 } },
    { "expect": { "window": "Settings", "path": "frameRect", "near": "workArea", "scale": [1, 1, 0.5, 1] } },

    { "log": "Minimise, then restore from the Shelf" },
    { "click": { "window": "Settings", "part": "minimize" } },
    { "wait": 800 },
    { "expect": { "window": "Settings", "path": "minimized", "equals": true } },
    { "restore": "Settings" },
    { "expect": { "window": "Settings", "path": "minimized", "equals": false } },
    { "expect": { "window": "Settings", "path": "focused", "equals": true } },

    { "log": "Overview" },
    { "call": "setSurface", "args": ["overview"] },
    { "wait": 900 },
    { "expect": { "path": "overview", "equals": true } },
    { "expect": { "window": "Settings", "path": "inOverview", "equals": true } },
    { "call": "setSurface", "args": [""] },
    { "wait": 800 },

    { "log": "Spaces: carry a window with the keyboard, send it back from its menu, drag it in Overview" },
    { "key": "Ctrl+Alt+Shift+Right" },
    { "wait": 1200 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "expect": { "window": "Settings", "path": "space", "equals": 1 } },
    { "expect": { "window": "Settings", "path": "visible", "equals": true } },
    { "expect": { "window": "Settings", "path": "focused", "equals": true } },
    { "rightClick": { "window": "Settings", "part": "titlebar", "at": [200, 20] } },
    { "wait": 600 },
    { "click": { "item": "moveToSpace0" } },
    { "wait": 1200 },
    { "expect": { "window": "Settings", "path": "space", "equals": 0 } },
    { "expect": { "window": "Settings", "path": "visible", "equals": false } },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "key": "Alt+1" },
    { "wait": 1200 },
    { "expect": { "window": "Settings", "path": "visible", "equals": true } },
    { "call": "setSurface", "args": ["overview"] },
    { "wait": 1000 },
    { "drag": { "from": { "window": "Settings", "part": "frame" }, "to": { "item": "spaceChip2" }, "steps": 24 } },
    { "wait": 1200 },
    { "expect": { "window": "Settings", "path": "space", "equals": 2 } },
    { "expect": { "window": "Settings", "path": "inOverview", "equals": false } },
    { "call": "setSurface", "args": [""] },
    { "wait": 800 },
    { "key": "Alt+3" },
    { "wait": 1200 },
    { "key": "Alt+Shift+1" },
    { "wait": 1200 },
    { "expect": { "path": "currentSpace", "equals": 0 } },
    { "expect": { "window": "Settings", "path": "space", "equals": 0 } },

    { "log": "Music: shuffle, repeat, the library, and the media and volume keys" },
    { "call": "launch", "args": ["music", {}] },
    { "waitFor": { "windows": 2, "timeout": 10000 } },
    { "wait": 1200 },
    { "click": { "item": "shuffleButton" } },
    { "wait": 500 },
    { "expect": { "path": "media.shuffle", "equals": true } },
    { "log": "A click that only a TapHandler takes must not raise the window underneath (Settings)" },
    { "expect": { "window": "Music", "path": "focused", "equals": true } },
    { "click": { "item": "shuffleButton" } },
    { "wait": 500 },
    { "expect": { "path": "media.shuffle", "equals": false } },
    { "click": { "item": "repeatButton" } },
    { "wait": 500 },
    { "expect": { "path": "media.repeat", "equals": 2 } },
    { "click": { "item": "repeatButton" } },
    { "wait": 400 },
    { "click": { "item": "repeatButton" } },
    { "wait": 500 },
    { "expect": { "path": "media.repeat", "equals": 1 } },
    { "click": { "item": "musicSongs" } },
    { "wait": 800 },
    { "click": { "item": "song2" } },
    { "wait": 700 },
    { "expect": { "path": "media.queueIndex", "equals": 2 } },
    { "expect": { "path": "media.playing", "equals": true } },
    { "key": "Toggle Media Play/Pause" },
    { "wait": 500 },
    { "expect": { "path": "media.playing", "equals": false } },
    { "key": "Media Next" },
    { "wait": 500 },
    { "expect": { "path": "media.queueIndex", "equals": 3 } },
    { "key": "Volume Down" },
    { "wait": 500 },
    { "expect": { "path": "audio.volume", "equals": 0.5625 } },
    { "key": "Volume Up" },
    { "wait": 500 },
    { "expect": { "path": "audio.volume", "equals": 0.625 } },
    { "click": { "item": "musicNow" } },
    { "wait": 500 },
    { "click": { "window": "Music", "part": "close" } },
    { "waitFor": { "windows": 1, "timeout": 4000 } },

    { "log": "Controller: the prompt, the interface and its actions, and disconnecting" },
    { "gamepad": { "connect": "playstation", "name": "DualShock 4" } },
    { "wait": 700 },
    { "expect": { "path": "controller.prompt", "equals": true } },
    { "gamepad": { "tap": "east" } },
    { "wait": 500 },
    { "expect": { "path": "controller.prompt", "equals": false } },
    { "expect": { "path": "settings.controllerInterface", "equals": false } },
    { "gamepad": { "disconnect": true } },
    { "gamepad": { "connect": "xbox", "name": "Xbox Wireless Controller" } },
    { "wait": 700 },
    { "expect": { "path": "controller.prompt", "equals": true } },
    { "gamepad": { "tap": "south" } },
    { "wait": 600 },
    { "expect": { "path": "settings.controllerInterface", "equals": true } },
    { "gamepad": { "tap": "north" } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "beam" } },
    { "expect": { "path": "controller.keyboard", "equals": true } },
    { "gamepad": { "tap": "east" } },
    { "wait": 500 },
    { "expect": { "path": "controller.keyboard", "equals": false } },
    { "gamepad": { "tap": "east" } },
    { "wait": 700 },
    { "expect": { "path": "surface", "equals": "" } },
    { "gamepad": { "tap": "start" } },
    { "wait": 700 },
    { "expect": { "path": "surface", "equals": "control-center" } },
    { "gamepad": { "tap": "east" } },
    { "wait": 700 },
    { "expect": { "path": "surface", "equals": "" } },
    { "gamepad": { "tap": "rb" } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "gamepad": { "tap": "lb" } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 0 } },
    { "gamepad": { "stick": [0.8, 0], "ms": 400 } },
    { "expect": { "path": "controller.cursorVisible", "equals": true } },
    { "gamepad": { "disconnect": true } },
    { "wait": 600 },
    { "expect": { "path": "settings.controllerInterface", "equals": false } },

    { "log": "Three-finger touchpad swipes: the strip follows the fingers, a flick carries on" },
    { "gesture": { "begin": { "fingers": 3 } } },
    { "gesture": { "move": [-320, 0], "steps": 8, "ms": 16 } },
    { "expect": { "path": "gesture.active", "equals": true } },
    { "expect": { "path": "gesture.axis", "equals": "horizontal" } },
    { "expect": { "path": "spaceOffset", "near": 0.25, "tolerance": 0.01 } },
    { "gesture": { "end": true } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "expect": { "path": "spaceOffset", "near": 1, "tolerance": 0.01 } },
    { "log": "A slow, short swipe springs back" },
    { "gesture": { "fingers": 3, "by": [-200, 0], "steps": 10, "ms": 60 } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "expect": { "path": "spaceOffset", "near": 1, "tolerance": 0.01 } },
    { "log": "Fingers that stop before lifting do not fling" },
    { "gesture": { "begin": { "fingers": 3 } } },
    { "gesture": { "move": [500, 0], "steps": 10, "ms": 16 } },
    { "gesture": { "end": true, "after": 300 } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "gesture": { "fingers": 3, "by": [800, 0], "steps": 10 } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 0 } },
    { "log": "Swiping up opens Overview as far as the fingers go; down closes it" },
    { "gesture": { "begin": { "fingers": 3 } } },
    { "gesture": { "move": [0, -150], "steps": 8, "ms": 16 } },
    { "expect": { "path": "gesture.axis", "equals": "vertical" } },
    { "expect": { "path": "overviewProgress", "near": 0.5, "tolerance": 0.01 } },
    { "expect": { "window": "Settings", "path": "overviewMix", "near": 0.5, "tolerance": 0.01 } },
    { "gesture": { "move": [0, -150], "steps": 8, "ms": 16 } },
    { "gesture": { "end": true } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "overview" } },
    { "expect": { "window": "Settings", "path": "inOverview", "equals": true } },
    { "gesture": { "fingers": 3, "by": [0, 400], "steps": 10 } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "" } },
    { "expect": { "path": "overviewProgress", "near": 0, "tolerance": 0.01 } },
    { "expect": { "window": "Settings", "path": "overviewMix", "equals": 0 } },
    { "log": "A half-hearted swipe up leaves Overview closed; two fingers are not a system gesture" },
    { "gesture": { "fingers": 3, "by": [0, -90], "steps": 10, "ms": 60 } },
    { "wait": 900 },
    { "expect": { "path": "surface", "equals": "" } },
    { "expect": { "window": "Settings", "path": "inOverview", "equals": false } },
    { "gesture": { "fingers": 2, "by": [-600, 0], "steps": 10 } },
    { "wait": 600 },
    { "expect": { "path": "currentSpace", "equals": 0 } },
    { "log": "Touchscreen: three fingers move between Spaces, even over a window; two do not" },
    { "touch": { "fingers": 3, "from": { "window": "Settings", "part": "content" }, "by": [-700, 0], "steps": 10 } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 1 } },
    { "touch": { "fingers": 3, "from": [640, 400], "by": [700, 0], "steps": 10 } },
    { "wait": 900 },
    { "expect": { "path": "currentSpace", "equals": 0 } },
    { "touch": { "fingers": 2, "from": [640, 400], "by": [-700, 0], "steps": 10 } },
    { "wait": 600 },
    { "expect": { "path": "currentSpace", "equals": 0 } },

    { "log": "Close" },
    { "click": { "window": "Settings", "part": "close" } },
    { "waitFor": { "windows": 0, "timeout": 4000 } }
  ]
}
