// qtos-settingsd: user appearance and accessibility preferences.

class Settings
{
    PROP(bool darkMode=true READWRITE)
    // OKLCH hue in degrees used for the Lumen accent and the wallpaper.
    PROP(double accentHue=274 READWRITE)
    PROP(bool reduceMotion=false READWRITE)
    PROP(bool reduceTransparency=false READWRITE)
    PROP(bool increaseContrast=false READWRITE)
    PROP(bool livingWallpaper=false READWRITE)
    // Audio-reactive interface: the wallpaper, Now Playing and visualisers
    // move with what is playing.
    PROP(bool audioReactive=true READWRITE)
    // 0..1: how strongly.
    PROP(double reactiveIntensity=0.6 READWRITE)
    // The frequencies (Hz) that drive it.
    PROP(double reactiveLowHz=40 READWRITE)
    PROP(double reactiveHighHz=160 READWRITE)
    // Controller interface: a game controller drives the whole interface.
    // In use now (not remembered: it ends when the last controller goes).
    PROP(bool controllerInterface=false READWRITE)
    // Switch to it as soon as a controller connects, without asking.
    PROP(bool controllerAutoSwitch=false READWRITE)
    // 0..1: how fast the left stick moves the cursor.
    PROP(double controllerCursorSpeed=0.5 READWRITE)
    PROP(bool controllerVibration=true READWRITE)
    // PlayStation light bars follow the accent colour.
    PROP(bool controllerLightbar=true READWRITE)
    PROP(QString userName SOURCEONLYSETTER)
    PROP(QString hostName SOURCEONLYSETTER)
}
