// Now-playing session aggregated from MPRIS players on device; played by the
// QOR OS audio engine in simulation.
#include <QtCore/QVariantList>

class Media
{
    PROP(bool available=false SOURCEONLYSETTER)
    PROP(QString title SOURCEONLYSETTER)
    PROP(QString artist SOURCEONLYSETTER)
    PROP(QString album SOURCEONLYSETTER)
    PROP(QString player SOURCEONLYSETTER)
    // Artwork stand-in: an OKLCH hue the UI renders as a gradient.
    PROP(double artworkHue=280 SOURCEONLYSETTER)
    PROP(bool playing=false READWRITE)
    // Play the queue in a shuffled order (each track once per pass).
    PROP(bool shuffle=false READWRITE)
    // 0: stop after the last track, 1: repeat the queue, 2: repeat the track.
    PROP(int repeat=1 READWRITE)
    // True while a file is still loading at the play position.
    PROP(bool buffering=false SOURCEONLYSETTER)
    // Seconds.
    PROP(double position=0 SOURCEONLYSETTER)
    PROP(double duration=0 SOURCEONLYSETTER)
    // [{ "title": string, "artist": string, "album": string,
    //    "duration": double (0 until known), "hue": double,
    //    "kind": "session" | "file",
    //    "path": string (files),
    //    "session": { "style", "mode", "bpm", "root", "seed" } (QOR Sessions:
    //                 music generated live by the audio engine) }]
    PROP(QVariantList queue SOURCEONLYSETTER)
    PROP(int queueIndex=0 SOURCEONLYSETTER)

    SLOT(void togglePlayback())
    SLOT(void next())
    SLOT(void previous())
    SLOT(void seek(double seconds))
    SLOT(void playIndex(int index))
}
