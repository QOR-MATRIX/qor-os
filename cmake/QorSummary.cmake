# Prints a short configuration summary at the end of configure.

message(STATUS "")
message(STATUS "QOR OS (QOR OS ${PROJECT_VERSION}) configuration")
message(STATUS "  Qt              ${Qt6_VERSION} (${Qt6_DIR})")
message(STATUS "  Build type      ${CMAKE_BUILD_TYPE}")
message(STATUS "  Tests           ${QOR_BUILD_TESTS}")
message(STATUS "  Tools           ${QOR_BUILD_TOOLS}")
message(STATUS "  Platform        ${QOR_BUILD_PLATFORM}")
message(STATUS "  Compositor      ${QOR_BUILD_COMPOSITOR}")
if(QOR_BUILD_CORE AND QOR_CORE_SOURCE_DIR)
    message(STATUS "  QOR core        ${QOR_CORE_SOURCE_DIR} [${QOR_CORE_FEATURES}]")
elseif(QOR_BUILD_CORE)
    message(STATUS "  QOR core        demiurge-chain ${QOR_CORE_COMMIT} [${QOR_CORE_FEATURES}]")
else()
    message(STATUS "  QOR core        OFF (install Rust's cargo to build it)")
endif()
message(STATUS "  QML output dir  ${QT_QML_OUTPUT_DIRECTORY}")
message(STATUS "")
