pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import QtMultimedia

// Lumen interface sounds: short, quiet cues for moments that benefit from
// one (a notification arrives, the session locks or unlocks, the volume
// changes, a device connects). The shell binds `enabled`, `volume` and
// `device` to the audio service; nothing touches the audio system until
// sounds are enabled.
//
//   Sounds.play("notification")
//
// The cues are generated by tools/sounds/generate_sounds.py.
QtObject {
    id: root

    property bool enabled: false
    // Linear gain, 0..1 (the shell applies the perceptual taper).
    property real volume: 0.25
    // Description of the output to play on; empty: the system default.
    property string device: ""

    readonly property list<string> names: ["notification", "lock", "unlock", "volume", "connect"]

    function play(name: string) {
        if (!enabled || volume <= 0)
            return;
        const effect = _effects[name];
        if (effect)
            effect.play();
        else
            console.warn("Unknown interface sound", name);
    }

    property var _effects: ({})
    property MediaDevices _devices: null

    readonly property Component _devicesFactory: Component {
        MediaDevices { }
    }
    readonly property Component _effectFactory: Component {
        SoundEffect {
            volume: root.volume
            audioDevice: {
                const outputs = root._devices ? root._devices.audioOutputs : [];
                for (let i = 0; i < outputs.length; ++i) {
                    if (outputs[i].description === root.device)
                        return outputs[i];
                }
                return root._devices ? root._devices.defaultAudioOutput : undefined;
            }
        }
    }

    onEnabledChanged: {
        if (!enabled || _devices)
            return;
        _devices = _devicesFactory.createObject(root) as MediaDevices;
        const effects = {};
        for (const name of names)
            effects[name] = _effectFactory.createObject(root, { source: Qt.resolvedUrl("sounds/" + name + ".wav") });
        _effects = effects;
    }
}
