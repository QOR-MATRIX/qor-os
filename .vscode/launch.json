{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "qtos-shell (lock screen)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "C:/Qt/6.12.0/msvc2022_64/bin;${env:PATH}" },
        { "name": "QT_FORCE_STDERR_LOGGING", "value": "1" },
        { "name": "QT_LOGGING_RULES", "value": "qtos.*=true" }
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "qtos-shell (desktop, Files + Music)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/qtos-shell.exe",
      "args": ["--unlocked", "--open", "files,music"],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "C:/Qt/6.12.0/msvc2022_64/bin;${env:PATH}" },
        { "name": "QT_FORCE_STDERR_LOGGING", "value": "1" }
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "qtos-shell (QML debugger)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/qtos-shell.exe",
      "args": ["--unlocked", "-qmljsdebugger=port:3768,block"],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "C:/Qt/6.12.0/msvc2022_64/bin;${env:PATH}" }
      ],
      "console": "integratedTerminal"
    }
  ]
}
