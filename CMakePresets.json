{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows · MSVC 2022 · Debug",
      "description": "Ninja + MSVC. Run from a Developer PowerShell (tools/dev/Enter-QorShell.ps1) or an IDE kit.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows · MSVC 2022 · RelWithDebInfo",
      "description": "Optimised build with symbols — the default for day-to-day shell work.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-vs",
      "displayName": "Windows · Visual Studio 17 2022",
      "description": "Multi-config Visual Studio solution. Works without a developer shell.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux · Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux · RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI · Windows",
      "inherits": "windows-release",
      "cacheVariables": {
        "QOR_WARNINGS_AS_ERRORS": "ON",
        "QOR_BUILD_CORE": "ON"
      },
      "description": "Warnings are errors; the QOR core is required, so a runner without cargo fails rather than skipping it."
    },
    {
      "name": "ci-linux",
      "displayName": "CI · Linux",
      "inherits": "linux-release",
      "cacheVariables": {
        "QOR_WARNINGS_AS_ERRORS": "ON",
        "QOR_BUILD_CORE": "ON"
      },
      "description": "Warnings are errors and the QOR core is required, as on Windows."
    },
    {
      "name": "linux-asan",
      "displayName": "Linux · AddressSanitizer and UBSan",
      "inherits": "linux-base",
      "description": "The suites under sanitizers, to find memory and undefined-behaviour bugs. Never installed.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "QOR_SANITIZE": "address,undefined",
        "QOR_BUILD_CORE": "OFF",
        "QOR_BUILD_PLATFORM": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-vs-release",
      "configurePreset": "windows-vs",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "qmllint-windows",
      "configurePreset": "windows-release",
      "targets": [
        "all_qmllint"
      ]
    },
    {
      "name": "qmllint-linux",
      "configurePreset": "linux-release",
      "targets": [
        "all_qmllint"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "windows-debug",
      "inherits": "test-base",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "inherits": "test-base",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "inherits": "test-base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "test-base",
      "configurePreset": "linux-release"
    },
    {
      "name": "ci-windows",
      "inherits": "test-base",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-linux",
      "inherits": "test-base",
      "configurePreset": "ci-linux"
    },
    {
      "name": "linux-asan",
      "inherits": "test-base",
      "configurePreset": "linux-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:detect_stack_use_after_return=1:strict_string_checks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ]
}
